{
  "name": "@react-ui-org/docoff",
  "description": "Library of custom HTML elements for creating flexible and simple to use `React.Component` documentation",
  "version": "0.7.1",
  "keywords": [
    "react",
    "documentation",
    "ui",
    "components",
    "ui-library",
    "ui-components",
    "pattern-library",
    "react-components",
    "react-component-library"
  ],
  "homepage": "https://github.com/react-ui-org/docoff",
  "author": "The React UI Authors (https://github.com/react-ui-org/react-ui/graphs/contributors)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/react-ui-org/react-ui/issues"
  },
  "browser": "public/generated/bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/react-ui-org/docoff"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.0 || ^24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@ungap/custom-elements": "^1.3.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "core-js": "^3.50.0",
    "markdown-it": "^14.3.2",
    "path-browserify": "^1.0.1",
    "prismjs": "^1.30.0",
    "process": "^0.11.10",
    "react-docgen": "^8.0.4",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/register": "^7.29.7",
    "@visionappscz/eslint-config-visionapps": "^1.8.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-prismjs": "^2.1.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-markdown": "^2.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "uglify-js": "^3.19.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "scripts": {
    "build": "webpack --mode=production",
    "postinstall": "sh scripts/write-lockfile-hash.sh",
    "prepublishOnly": "npm run build",
    "start": "webpack serve --mode=development",
    "test": "npm run test:eslint && npm run test:jest",
    "test:eslint": "eslint --ext js,jsx src",
    "test:jest": "jest"
  },
  "jest": {
    "transformIgnorePatterns": [
      "/node_modules/(?!(react-docgen|strip-indent|min-indent)/)"
    ]
  }
}
